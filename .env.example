# Supabase Project Configuration (Find in Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Supabase Edge Functions Secret
# IMPORTANT: Configure this in Supabase Dashboard -> Edge Functions -> Secrets
# or via CLI: supabase secrets set GEMINI_API_KEY=your_gemini_key
GEMINI_API_KEY=your_gemini_api_key_here
